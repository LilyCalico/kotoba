// テーブルの定義。変更したら `pnpm --filter @kotoba/api db:migrate` で migration を作る。

generator client {
  provider               = "prisma-client"
  // tsconfig の rootDir が src のため、生成物も src の下に置く。
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Language {
  sv
  ja
}

enum PartOfSpeech {
  noun
  verb
  adjective
  phrase
}

/// 出題する単語。形は packages/shared の wordSchema と 1 対 1 に対応する。
/// 絞り込みに使う項目は列に、UI 言語ごとに書き分けるテキストは { ja, en } の形のまま jsonb に置く。
model Word {
  id              String       @id
  language        Language
  word            String
  reading         String
  partOfSpeech    PartOfSpeech @map("part_of_speech")
  /// 1 が最も稀で 5 が最も頻繁。出題の重み
  frequency       Int
  acceptedAnswers String[]     @map("accepted_answers")
  /// { ja, en }
  definition      Json
  /// { ja, en }
  teaser          Json
  /// { ja: [3 つ], en: [3 つ] }
  hints           Json
  /// { ja, en }
  literal         Json?
  /// { ja, en }
  note            Json?
  /// { sv, translations: { ja, en } }
  example         Json?
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@index([language])
  @@map("words")
}
