{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/games": {
      "post": {
        "operationId": "start",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartGameRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "ゲームを始めた",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameStart"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "tags": [
          "games"
        ]
      }
    },
    "/api/v1/games/{gameId}/inputs": {
      "post": {
        "operationId": "input",
        "parameters": [
          {
            "name": "gameId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlayerInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "入力を判定した",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InputResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "tags": [
          "games"
        ]
      }
    },
    "/api/v1/games/{gameId}/hints": {
      "post": {
        "operationId": "revealHint",
        "parameters": [
          {
            "name": "gameId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HintRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ヒントを開示した",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Hint"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "tags": [
          "games"
        ]
      }
    },
    "/api/v1/games/{gameId}/give-up": {
      "post": {
        "operationId": "giveUp",
        "parameters": [
          {
            "name": "gameId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ギブアップを確定した",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "tags": [
          "games"
        ]
      }
    }
  },
  "info": {
    "title": "Kotoba API",
    "description": "ゲームセッション API。仕様は docs/specifications/api.md を参照する。",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "StartGameRequest": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "sv",
              "ja"
            ]
          },
          "locale": {
            "default": "en",
            "type": "string",
            "enum": [
              "ja",
              "en"
            ]
          },
          "excludeWordIds": {
            "default": [],
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "language"
        ]
      },
      "GameStart": {
        "type": "object",
        "properties": {
          "gameId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "language": {
            "type": "string",
            "enum": [
              "sv",
              "ja"
            ]
          },
          "teaser": {
            "type": "string"
          }
        },
        "required": [
          "gameId",
          "language",
          "teaser"
        ],
        "additionalProperties": false
      },
      "PlayerInput": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "text"
        ]
      },
      "InputResult": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "question"
                ]
              },
              "verdict": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "unclear",
                  "irrelevant",
                  "not_a_question"
                ]
              }
            },
            "required": [
              "kind",
              "verdict"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "answer"
                ]
              },
              "correct": {
                "type": "boolean"
              },
              "result": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/GameResult"
                  }
                ]
              }
            },
            "required": [
              "kind",
              "correct"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "unsupported_language"
                ]
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          }
        ]
      },
      "GameResult": {
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "cleared",
              "gave_up"
            ]
          },
          "wordId": {
            "type": "string"
          },
          "word": {
            "type": "string"
          },
          "partOfSpeech": {
            "type": "string",
            "enum": [
              "noun",
              "verb",
              "adjective",
              "phrase"
            ]
          },
          "definition": {
            "type": "string"
          },
          "literal": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "example": {
            "type": "object",
            "properties": {
              "sv": {
                "type": "string"
              },
              "translation": {
                "type": "string"
              }
            },
            "required": [
              "sv",
              "translation"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "outcome",
          "wordId",
          "word",
          "partOfSpeech",
          "definition"
        ],
        "additionalProperties": false
      },
      "HintRequest": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "index"
        ]
      },
      "Hint": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "index",
          "text"
        ],
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "code": {
            "type": "string",
            "enum": [
              "validation_error",
              "game_not_found",
              "game_finished",
              "hint_out_of_order",
              "hint_limit_reached",
              "rate_limited",
              "internal_error",
              "ai_unavailable",
              "ai_rate_limited"
            ]
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "additionalProperties": false
      }
    }
  }
}
