# ローカルの Supabase（`pnpm --filter @kotoba/api db:start`）につなぐ値。`cp .env.example .env` で使う。
# 本番では DATABASE_URL に Supabase のトランザクションプーラー（6543）、
# DIRECT_URL に直接接続かセッションプーラー（5432）の URL を入れる。

# アプリ（PrismaClient）が使う
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# Prisma CLI（migrate・db seed）が使う
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# 入力の分類と質問への回答に使う Gemini API のキー（https://aistudio.google.com/apikey で発行する）。
# 未設定でも api は起動し、AI が要る入力は ai_unavailable を返す。
GEMINI_API_KEY=""
# 使うモデル。未設定なら gemini-3.5-flash-lite
# GEMINI_MODEL="gemini-3.5-flash-lite"
# Gemini API の接続先。E2E でスタブサーバーへ向けるときだけ指定する
# GEMINI_BASE_URL="http://localhost:3002"
